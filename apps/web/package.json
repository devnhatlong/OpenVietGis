{
  "name": "@openvietgis/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build && node scripts/build-offline-shell.mjs",
    "lint": "eslint src vite.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@openvietgis/client-sdk": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "maplibre-gl": "6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
